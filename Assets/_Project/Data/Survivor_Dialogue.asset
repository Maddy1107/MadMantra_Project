  m_Script: {fileID: 11500000, guid: cbf1ec64108f45e6ad63734d91843d30, type: 3}
  m_Name: Survivor_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::MadMantra.Dialogue.DialogueData
  lines:
  - speaker: Survivor
    text: You're finally awake... The bulkhead sealed before I could get back to you.
  - speaker: Survivor
    text: Power failed across Sector 4. Good work getting the auxiliary panel online.
  - speaker: Survivor
    text: Wait - you didn't find the override core in Room 1, did you?
  - speaker: Survivor
    text: Without it, the main lift won't move. I'll have to check the exit corridor myself...
